# คัดลอกเป็น .env แล้วใส่ค่า (ไฟล์ .env ไม่ถูก commit) ค่าเหล่านี้อยู่ฝั่งเซิร์ฟเวอร์เท่านั้น

# --- Supabase ---
# URL ของโปรเจกต์ และ publishable (anon) key — Supabase → Settings → API
# (ใช้ร่วมกับ token ของผู้ใช้ที่ล็อกอินเท่านั้น ไม่ใช้ service role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- OCR ---
# gemini | typhoon  (ไม่ตั้ง = ไม่ใช้ OCR: ระบบเก็บรูปแล้วให้กรอกเอง)
OCR_PROVIDER=

GEMINI_API_KEY=
# ชื่อรุ่นเปลี่ยนบ่อย: รัน npm run check-keys จะแสดงรุ่น Flash ที่ใช้ได้กับคีย์ของคุณ
GEMINI_MODEL=gemini-3.8-flash
# รุ่นสำรอง: ใช้เมื่อรุ่นหลักยุ่ง (503) หรือโควตาเต็ม (429) เช่น gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=
# ไม่ต้องตั้ง (ใช้ค่ามาตรฐานของรุ่น) ตั้งเมื่อจำเป็นเท่านั้น
# GEMINI_TEMPERATURE=

TYPHOON_API_KEY=

# ระดับการคิดของ Gemini 3: minimal | low | medium | high | default (ค่าเริ่มต้น low — เร็วกว่ามากและพอสำหรับดึงข้อมูลจากใบ)
# GEMINI_THINKING_LEVEL=low

# เวลารอโมเดล (มิลลิวินาที): รวมทุกคำขอ/ทุกรุ่น และเพดานต่อหนึ่งคำขอ — ต้องไม่เกิน 60 วิ ซึ่งเป็นเพดานของ Vercel
# ถ้าช้ากว่านี้ระบบจะเก็บรูปไว้แล้วให้กรอกเอง (ค่าเริ่มต้น 48000 และต่อคำขอ = ทั้งงบ)
# อย่าตั้งต่อคำขอต่ำกว่า ~35000: Gemini อ่านใบจริงใช้ราว 25–35 วิ
# OCR_BUDGET_MS=48000
# OCR_TIMEOUT_MS=48000

# --- อื่น ๆ ---
# รายชื่อสาขา คั่นด้วยจุลภาค (ไม่ตั้ง = สยาม,ลาดพร้าว,บางนา,รังสิต)
# RECEIPT_BRANCHES=
# ห้ามตั้งในระบบจริง: โหมดสาธิตสร้างข้อมูลสมมติ (ใช้ในเทสต์เท่านั้น)
# OCR_ALLOW_MOCK=1
